@model TeklifYonetimSistemi.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Genel Bakış";
}

<div class="row">
    @* --- KULLANICI ROLÜNE GÖRE FARKLI KARTLAR GÖSTER --- *@

    @if (User.IsInRole("Admin"))
    {
        <div class="col-md-3">
            <div class="card radius-10 bg-success mb-3">
                <div class="card-body text-center">
                    <div class="widget-icon mx-auto mb-3 bg-white-1 text-white">
                        <i class="bi bi-wallet2"></i>
                    </div>
                    <h3 class="text-white">@Model.ToplamCiro.ToString("N0") ₺</h3>
                    <p class="mb-0 text-white">Toplam Ciro</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <a asp-controller="Quote" asp-action="Index" asp-route-status="YoneticiOnayBekliyor" style="text-decoration:none;">
                <div class="card radius-10 bg-warning mb-3">
                    <div class="card-body text-center">
                        <div class="widget-icon mx-auto mb-3 bg-white-1 text-white">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                        <h3 class="text-white">@Model.YoneticiOnayiBekleyen</h3>
                        <p class="mb-0 text-white">Onayınızı Bekleyenler</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <div class="card radius-10 bg-danger mb-3">
                <div class="card-body text-center">
                    <div class="widget-icon mx-auto mb-3 bg-white-1 text-white">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <h3 class="text-white">@Model.KritikStokSayisi</h3>
                    <p class="mb-0 text-white">Kritik Stoklu Ürün</p>
                </div>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col-md-4">
                <div class="card radius-10 bg-gradient-cosmic mb-3">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div>
                                <p class="mb-0 text-secondary">Tahmini Net Kâr</p>
                                <h4 class="my-1 text-success">@Model.ToplamNetKar.ToString("N2") ₺</h4>
                            </div>
                            <div class="widget-icon-2 bg-gradient-success text-white ms-auto">
                                <i class="bi bi-graph-up-arrow"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card radius-10 border-start border-0 border-4 border-warning mb-3">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div>
                                <p class="mb-0 text-secondary">Pasif Müşteriler (6 Ay+)</p>
                                <h4 class="my-1 text-warning">@Model.PasifMusteriSayisi</h4>
                            </div>
                            <div class="widget-icon-2 bg-gradient-warning text-white ms-auto">
                                <i class="bi bi-telephone-outbound"></i>
                            </div>
                        </div>
                        <small class="text-muted">İletişime geçilmeli</small>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card radius-10 mb-3">
                    <div class="card-header bg-transparent border-bottom-0">
                        <h6 class="mb-0">En Çok Satan Kategoriler</h6>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            @if (Model.KategoriDagilimi != null)
                            {
                                foreach (var item in Model.KategoriDagilimi)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent">
                                        @item.Key
                                        <span class="badge bg-primary rounded-pill">@item.Value Adet</span>
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (User.IsInRole("SatisElemani"))
    {
        <div class="col-md-4">
            <div class="card radius-10 bg-danger mb-3">
                <div class="card-body text-center">
                    <div class="widget-icon mx-auto mb-3 bg-white-1 text-white">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                    <h3 class="text-white">@Model.RevizeGerekenler</h3>
                    <p class="mb-0 text-white">Revize Etmeniz Gerekenler</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card radius-10 bg-info mb-3">
                <div class="card-body text-center">
                    <div class="widget-icon mx-auto mb-3 bg-white-1 text-white">
                        <i class="bi bi-people"></i>
                    </div>
                    <h3 class="text-white">@Model.MusteriOnayiBekleyen</h3>
                    <p class="mb-0 text-white">Müşteri Onayı Bekleyen</p>
                </div>
            </div>
        </div>
    }

    @if (User.IsInRole("FirmaKullanicisi"))
    {
        <div class="col-md-6">
            <a asp-controller="Quote" asp-action="Index" style="text-decoration:none;">
                <div class="card radius-10 bg-primary mb-3">
                    <div class="card-body text-center">
                        <div class="widget-icon mx-auto mb-3 bg-white-1 text-white">
                            <i class="bi bi-file-earmark-check"></i>
                        </div>
                        <h3 class="text-white">@Model.OnayimiBekleyenler</h3>
                        <p class="mb-0 text-white">Onaylamanız Gereken Teklifler</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-6">
            <div class="card radius-10 bg-success mb-3">
                <div class="card-body text-center">
                    <div class="widget-icon mx-auto mb-3 bg-white-1 text-white">
                        <i class="bi bi-building"></i>
                    </div>
                    <h3 class="text-white">@Model.AktifProjelerim</h3>
                    <p class="mb-0 text-white">Aktif Projeleriniz</p>
                </div>
            </div>
        </div>
        
    }

</div>

@* ORTAK ALAN: Ürün Sayısı (Herkes Görebilir veya Sadece Şirket İçi) *@
@if (!User.IsInRole("FirmaKullanicisi"))
{
    <div class="row">
        <div class="col-12">
            <div class="alert alert-light border shadow-sm">
                <i class="bi bi-box-seam me-2"></i> Sistemde toplam <strong>@Model.ToplamUrun</strong> adet ürün/hizmet tanımlı.
            </div>
        </div>
    </div>
}
@if (User.IsInRole("Admin") || User.IsInRole("SatisElemani"))
{
    <div class="col-md-3">
        <div class="card text-center mb-3 shadow-sm border-0">
            <div class="card-body">
                <h6 class="text-muted">Teklif Başarı Oranı</h6>
                <div class="position-relative d-inline-block mt-2">
                    <div style="width: 80px; height: 80px; border-radius: 50%; background: conic-gradient(#4caf50 @Model.TeklifBsariOrani%, #e0e0e0 0); display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                        <div style="width: 60px; height: 60px; background: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold;">
                            %@Model.TeklifBsariOrani
                        </div>
                    </div>
                </div>
                <p class="small text-muted mt-2 mb-0">Onaylanan / Toplam</p>
            </div>
        </div>
    </div>
}