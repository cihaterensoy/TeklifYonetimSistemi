@model TeklifYonetimSistemi.Models.ViewModels.KullaniciEkleViewModel

@{
    // Controller'dan (KullaniciEkleController.cs - Ekle GET metodu) gelen Customer Id'yi yakala
    var otomatikId = ViewData["OtomatikMusteriId"]?.ToString();
}

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">
            <i class="fas fa-user-plus"></i>
            @if (!string.IsNullOrEmpty(otomatikId))
            {
                <span>Müşteri Yetkilisi Ekle</span>
            }
            else
            {
                <span>Yeni Kullanıcı Ekle</span>
            }
        </h4>
        <a href="/Home/Index" class="btn btn-light btn-sm text-primary fw-bold">İptal</a>
    </div>
    <div class="card-body">
        <form asp-action="Ekle" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            @* Artık hidden input'ları otomatik eklemek yerine, JavaScript ile formun sonuna ekleyeceğiz. *@

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Isim" class="form-label fw-bold">İsim</label>
                    <input asp-for="Isim" class="form-control" placeholder="Örn: Ahmet" />
                    <span asp-validation-for="Isim" class="text-danger small"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Soyisim" class="form-label fw-bold">Soyisim</label>
                    <input asp-for="Soyisim" class="form-control" placeholder="Örn: Yılmaz" />
                    <span asp-validation-for="Soyisim" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-bold">Email (Kullanıcı Adı)</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="ornek@sirket.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Sifre" class="form-label fw-bold">Şifre</label>
                <input asp-for="Sifre" type="password" class="form-control" />
                <span asp-validation-for="Sifre" class="text-danger small"></span>
                <small class="text-muted d-block mt-1"><i class="fas fa-info-circle"></i> En az 3 karakter olmalı.</small>
            </div>

            <div class="mb-3">
                <label asp-for="Rol" class="form-label fw-bold">Yetki (Rol)</label>
                @* HATA ÇIKARAN C# KISMI KALDIRILDI *@
                <select asp-for="Rol" class="form-select" asp-items="ViewBag.Roller" id="rolSecimi" onchange="rolDegisti()">
                    <option value="">Bir Rol Seçiniz</option>
                </select>
                <span asp-validation-for="Rol" class="text-danger small"></span>
            </div>

            <div class="mb-4 p-3 bg-light border rounded border-primary" id="firmaKutusu" style="display:none;">
                <label asp-for="CustomerId" class="form-label fw-bold text-primary">
                    <i class="fas fa-building"></i> Bağlı Olduğu Firma
                </label>
                @* HATA ÇIKARAN C# KISMI KALDIRILDI *@
                <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Firmalar" id="CustomerId">
                    <option value="">-- Firma Yok / Serbest Kullanıcı --</option>
                </select>
                <small class="text-muted">
                    Bu kullanıcı otomatik olarak seçilen firmaya atanacaktır.
                </small>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-success btn-lg">
                    <i class="fas fa-save"></i> Kullanıcıyı Oluştur
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function rolDegisti() {
            var secilenRol = document.getElementById("rolSecimi").value;
            var firmaDiv = document.getElementById("firmaKutusu");

            // EĞER SEÇİLEN ROL "FirmaKullanicisi" İSE KUTUYU AÇ
            if (secilenRol === "FirmaKullanicisi") {
                firmaDiv.style.display = "block";
                firmaDiv.classList.add("animate__animated", "animate__fadeIn");
            } else {
                firmaDiv.style.display = "none";
                // Kutu gizlenince seçimi temizle
                document.getElementById("CustomerId").value = "";
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            // Controller'dan gelen ID'yi yakala
            const otomatikId = "@otomatikId";

            const rolSecimiDropdown = document.getElementById("rolSecimi");
            const customerIdDropdown = document.getElementById("CustomerId");

            if (otomatikId && otomatikId !== "") {
                const firmaKutusuDiv = document.getElementById("firmaKutusu");

                // 1. Rolü "FirmaKullanicisi" olarak ayarla ve DEVRE DIŞI BIRAK
                rolSecimiDropdown.value = "FirmaKullanicisi";
                rolSecimiDropdown.disabled = true;

                // 2. Firma kutusunu göster
                firmaKutusuDiv.style.display = "block";
                firmaKutusuDiv.classList.add("animate__animated", "animate__fadeIn");

                // 3. Firma dropdown'unda gelen ID'yi seçili yap ve DEVRE DIŞI BIRAK
                if (customerIdDropdown) {
                    customerIdDropdown.value = otomatikId;
                    customerIdDropdown.disabled = true;
                }

                // 4. GİZLİ INPUT EKLEME: Disabled elementler POST edilmediği için değerleri manuel ekliyoruz.
                const form = document.querySelector("form");

                // Customer ID (Bağlı olduğu Firma) için gizli alan
                const hiddenCustomerId = document.createElement("input");
                hiddenCustomerId.type = "hidden";
                hiddenCustomerId.name = "CustomerId";
                hiddenCustomerId.value = otomatikId;
                form.appendChild(hiddenCustomerId);

                // Rol bilgisi için gizli alan
                const hiddenRol = document.createElement("input");
                hiddenRol.type = "hidden";
                hiddenRol.name = "Rol";
                hiddenRol.value = "FirmaKullanicisi";
                form.appendChild(hiddenRol);

            } else {
                // Normal akış: Sadece manuel seçim yapılıyorsa
                rolDegisti();
            }
        });
    </script>
}