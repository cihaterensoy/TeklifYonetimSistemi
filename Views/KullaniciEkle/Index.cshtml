@model List<TeklifYonetimSistemi.Models.KullaniciModel>

@{
    ViewData["Title"] = "Kullanıcı Listesi";
}

<div class="container mt-4">

    @* 👇 FİLTRE DURUMU BİLDİRİMİ *@
    @if (ViewBag.FiltreliMi == true)
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center shadow-sm border-0 border-start border-4 border-info mb-3">
            <div>
                <i class="fas fa-filter me-2"></i>
                <strong>@ViewBag.FirmaAdi</strong> firmasına bağlı yetkilileri görüntülüyorsunuz.
            </div>
            <a asp-action="Index" asp-route-customerId="" class="btn btn-sm btn-light text-info fw-bold">
                <i class="fas fa-times"></i> Filtreyi Temizle
            </a>
        </div>
    }
    @* 👆 FİLTRE DURUMU BİLDİRİMİ BİTTİ *@

    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Kullanıcı Listesi @(ViewBag.FirmaAdi != null ? $" ({ViewBag.FirmaAdi})" : "")</h4>

            @* 👇 DİNAMİK YETKİLİ EKLE BUTONU *@
            @if (ViewBag.FiltreliMi == true)
            {
                <a asp-action="Ekle" asp-route-customerId="@ViewBag.FiltreCustomerId" class="btn btn-light btn-sm text-primary fw-bold">
                    <i class="fas fa-user-plus"></i> Bu Firmaya Yetkili Ekle
                </a>
            }
            else
            {
                <a asp-action="Ekle" class="btn btn-light btn-sm text-primary fw-bold">
                    <i class="fas fa-user-plus"></i> Yeni Kullanıcı Ekle
                </a>
            }
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ad Soyad</th>
                        <th>Email / Kullanıcı Adı</th>
                        <th>Bağlı Olduğu Firma</th>
                        <th>Telefon</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.Isim @user.Soyisim</td>
                            <td>
                                <div>@user.UserName</div>
                                <small class="text-muted">@user.Email</small>
                            </td>

                            @* FİRMA BİLGİSİ BURADA *@
                            <td>
                                @if (user.Customer != null)
                                {
                                    <span class="badge bg-info text-dark">
                                        <i class="fas fa-building"></i> @user.Customer.FirmaUnvani
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Şirket Personeli</span>
                                }
                            </td>

                            <td>@(user.PhoneNumber ?? "-")</td>
                            <td>
                                <a href="#" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>