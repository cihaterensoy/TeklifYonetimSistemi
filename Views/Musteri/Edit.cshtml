@model TeklifYonetimSistemi.Models.CustomerModel

@{
    ViewData["Title"] = "Müşteri Düzenle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0"><i class="bi bi-pencil-square"></i> Müşteri Bilgilerini Düzenle</h3>
                </div>
                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label asp-for="FirmaUnvani" class="form-label fw-bold required">Firma Ünvanı</label>
                                <input asp-for="FirmaUnvani" class="form-control" />
                                <span asp-validation-for="FirmaUnvani" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold required">E-Posta</label>
                                <input asp-for="Email" type="email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Telefon" class="form-label fw-bold">Telefon</label>
                                <input asp-for="Telefon" class="form-control" />
                                <span asp-validation-for="Telefon" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Il" class="form-label fw-bold">İl</label>
                                <input asp-for="Il" class="form-control" />
                                <span asp-validation-for="Il" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Ilce" class="form-label fw-bold">İlçe</label>
                                <input asp-for="Ilce" class="form-control" />
                                <span asp-validation-for="Ilce" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-9">
                                <label asp-for="Adres" class="form-label fw-bold">Açık Adres</label>
                                <textarea asp-for="Adres" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Adres" class="text-danger"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Fax" class="form-label fw-bold">Fax</label>
                                <input asp-for="Fax" class="form-control" />
                                <span asp-validation-for="Fax" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="FirmaDetay" class="form-label fw-bold">Firma Açıklaması / Notlar</label>
                            <textarea asp-for="FirmaDetay" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="FirmaDetay" class="text-danger"></span>
                        </div>

                        <div class="mb-4 form-check">
                            <input asp-for="MusteriAktifMi" class="form-check-input" type="checkbox" />
                            <label class="form-check-label fw-bold" asp-for="MusteriAktifMi">
                                @Html.DisplayNameFor(model => model.MusteriAktifMi)
                            </label>
                        </div>


                        <div class="d-flex justify-content-end">
                            <a asp-action="ana" class="btn btn-secondary me-2">
                                <i class="bi bi-arrow-left"></i> Listeye Dön
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        // İstemci taraflı doğrulama (client-side validation) için gerekli
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}