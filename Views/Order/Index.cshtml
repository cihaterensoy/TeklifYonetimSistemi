@model IEnumerable<TeklifYonetimSistemi.Models.QuoteModel>

@{
    ViewData["Title"] = "Siparişlerim";
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="fas fa-box-open text-success"></i> Siparişlerim</h2>

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-success text-white">
                    <tr>
                        <th>Sipariş No (Teklif No)</th>
                        <th>Proje Adı</th>
                        <th>Tarih</th>
                        <th class="text-end">Tutar</th>
                        <th class="text-center">Durum</th>
                        <th class="text-center">Detay</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                            @foreach(var item in Model)
                             {
                                    <tr>
                                        <td class="fw-bold">@item.TeklifNo</td>
                                        <td>@item.Project?.ProjeAdi</td>
                                        <td>@item.TeklifOlusturulmaTarihi.ToString("dd.MM.yyyy")</td>
                                        <td class="text-end fw-bold">@item.GenelToplam.ToString("C2")</td>
                                        <td class="text-center">
                                            <span class="badge bg-success">Onaylandı / Hazırlanıyor</span>
                                        </td>
                                        <td class="text-center">
                                            <a asp-controller="Quote" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detay</a>

                                        </td>
                                    </tr>
                             }
                    }
                    else
                    {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    Henüz onaylanmış bir siparişiniz bulunmamaktadır.
                                </td>
                            </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>