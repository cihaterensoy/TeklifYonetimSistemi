@model IEnumerable<TeklifYonetimSistemi.Models.ProductModel>

@{
    ViewData["Title"] = "Ürün Listesi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3><i class="bi bi-list-check"></i> Ürün ve Hizmet Listesi</h3>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Yeni Ürün Ekle
            </a>

        }
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Kategori</th>
                        <th>Ürün Adı</th>
                        <th>Birim</th>
                        <th class="text-end">Liste Fiyatı</th>
                        @if (User.IsInRole("Admin") || User.IsInRole("SatisElemani"))
                        {
                            <th class="text-center">Stok</th>
                            <th class="text-center">İşlem</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="@(item.UrunAktifMi ? "" : "table-danger text-muted")">
                                <td>
                                    <span class="badge bg-secondary">@item.Kategori</span>
                                </td>
                                <td class="fw-bold">
                                    @item.UrunAdi
                                    @if (!item.UrunAktifMi)
                                    {<span class="badge bg-danger ms-2">PASİF</span>}
                                </td>
                                <td>@item.Birim</td>

                                @* YENİ FİYAT GÖSTERİMİ *@
                                <td class="text-end fw-bold text-primary">
                                    @item.SatisFiyatListesi.ToString("N2") <small>@item.ParaBirimi</small>
                                </td>
                                @if (User.IsInRole("Admin") || User.IsInRole("SatisElemani"))
                                {
                                    <td class="text-center">
                                        @if (item.StokTakibiYapilsinMi)
                                        {
                                            if (item.StokMiktari < 5)
                                            {
                                                <span class="text-danger fw-bold">@item.StokMiktari (Kritik)</span>
                                            }
                                            else
                                            {
                                                <span>@item.StokMiktari</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                }

                                
                            <td class="text-center">
                                @if (User.IsInRole("Admin"))
                                {

                                    @if (item.UrunAktifMi)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                        <form asp-action="Pasif" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Aktif" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button class="btn btn-sm btn-success" title="Ürünü Tekrar Aktif Et">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        </form>
                                    }
                                    }
                                </td>
                                
                            </tr>
                            }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>