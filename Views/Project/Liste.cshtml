@if (ViewBag.MusteriAdi != null)
{
    <div class="alert alert-primary d-flex justify-content-between align-items-center">
        <span>
            <i class="fas fa-filter"></i>
            <strong>@ViewBag.MusteriAdi</strong> firmasına ait projeleri görüntülüyorsunuz.
        </span>
        <a asp-action="Index" class="btn btn-sm btn-outline-primary">Filtreyi Kaldır / Tümünü Gör</a>
    </div>
}