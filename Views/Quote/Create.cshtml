@model TeklifYonetimSistemi.Models.QuoteModel
@{
    ViewData["Title"] = "Yeni Teklif Oluştur";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fas fa-file-invoice"></i> Yeni Teklif Oluştur</h2>
    </div>

    @* 🚨 TEMEL VERİ KONTROLÜ *@
    @if (Model?.Project == null)
    {
        <div class="alert alert-danger">
            <h4><i class="fas fa-exclamation-triangle"></i> Kritik Hata!</h4>
            <p>Proje bilgisi bulunamadı. Lütfen proje listesinden tekrar deneyin.</p>
            <a asp-action="Index" asp-controller="Project" class="btn btn-danger mt-2">
                <i class="fas fa-arrow-left"></i> Proje Listesine Dön
            </a>
        </div>
        return;
    }

    @* 💡 PROJE VE MÜŞTERİ BİLGİSİ *@
    <div class="card bg-light mb-4 border-start border-primary border-4">
        <div class="card-body">
            @if (Model.Project.Customer != null)
            {
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h5 class="text-primary mb-1">@Model.Project.Customer.FirmaUnvani</h5>
                        <p class="mb-0 text-muted"><i class="fas fa-project-diagram"></i> Proje: <strong>@Model.Project.ProjeAdi</strong></p>
                    </div>
                    <div class="col-md-4 text-end">
                        <span class="badge bg-secondary p-2">Proje ID: @Model.ProjectId</span>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    <i class="fas fa-exclamation-circle"></i> Müşteri bilgisi bulunamadı.
                </div>
            }
        </div>
    </div>

    @* 📊 TEMP DATA MESAJLARI *@
    @if (TempData["HataMesaji"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-times-circle"></i> @TempData["HataMesaji"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Create" method="post" id="teklifForm">
        @* 📝 VALIDATION SUMMARY *@
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        @* 🔒 HIDDEN ALANLAR (Kur bilgileri buradan çıkarıldı) *@
        <input type="hidden" asp-for="ProjectId" />
        <input type="hidden" asp-for="Durum" />
        <input type="hidden" asp-for="TeklifNo" />
        <input type="hidden" asp-for="TeklifOlusturulmaTarihi" />
        <input type="hidden" asp-for="AraToplam" />
        <input type="hidden" asp-for="GenelToplam" />

        <div class="row">
            @* --- SOL KOLON --- *@
            <div class="col-lg-6">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h6 class="mb-0 fw-bold">Genel Bilgiler</h6>
                    </div>
                    <div class="card-body">
                        @* TEKLİF ADI *@
                        <div class="mb-3">
                            <label asp-for="TeklifAdi" class="form-label fw-bold">Teklif Başlığı</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-heading"></i></span>
                                <input asp-for="TeklifAdi" class="form-control" placeholder="Örn: 2024 Revize Teklifi" />
                            </div>
                            <span asp-validation-for="TeklifAdi" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            @* TEKLİF GEÇERLİLİK TARİHİ *@
                            <div class="col-md-6 mb-3">
                                <label asp-for="TeklifSonTarihi" class="form-label fw-bold">Geçerlilik Tarihi</label>
                                <input asp-for="TeklifSonTarihi" class="form-control" type="date" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="TeklifSonTarihi" class="text-danger small"></span>
                            </div>

                            @* VADE *@
                            <div class="col-md-6 mb-3">
                                <label asp-for="Vade" class="form-label fw-bold">Vade (Gün)</label>
                                <div class="input-group">
                                    <input asp-for="Vade" class="form-control" type="number" min="0" placeholder="30" />
                                    <span class="input-group-text">Gün</span>
                                </div>
                                <span asp-validation-for="Vade" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* --- SAĞ KOLON --- *@
            <div class="col-lg-6">
                @* 💱 KUR BİLGİLERİ (MANUEL GİRİŞ) *@
                <div class="card shadow-sm mb-4 border-info">
                    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                        <h6 class="mb-0"><i class="fas fa-money-bill-wave"></i> Kur Bilgileri</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DolarKuru" class="form-label fw-bold">Dolar (USD)</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    @* step="0.0001" kur hassasiyeti içindir *@
                                    <input asp-for="DolarKuru" id="inputDolar" class="form-control fw-bold" type="number" step="0.0001" placeholder="0.0000" />
                                </div>
                                <span asp-validation-for="DolarKuru" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EuroKuru" class="form-label fw-bold">Euro (EUR)</label>
                                <div class="input-group">
                                    <span class="input-group-text">€</span>
                                    <input asp-for="EuroKuru" id="inputEuro" class="form-control fw-bold" type="number" step="0.0001" placeholder="0.0000" />
                                </div>
                                <span asp-validation-for="EuroKuru" class="text-danger small"></span>
                            </div>
                        </div>
                        <small class="text-muted"><i class="fas fa-info-circle"></i> Kuru sabitlemek için değeri elle değiştirebilirsiniz.</small>
                    </div>
                </div>

                @* DİĞER DETAYLAR *@
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        @* KDV *@
                        <div class="mb-3">
                            @*
                            <label asp-for="KDVOrani" class="form-label fw-bold">KDV Oranı</label>
                            <div class="input-group">
                                @* step="any": Her türlü ondalıklı sayıyı kabul eder (Örn: 18, 18.5, 1.75).
            type="number": Mobil tarayıcılarda sayısal klavye açar.
                                
                                <input asp-for="KDVOrani" class="form-control" type="number" step="any" placeholder="20" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="KDVOrani" class="text-danger small"></span>
                        </div>
                    *@

                        @* NOTLAR *@
                        <div class="mb-3">
                            <label asp-for="TeklifNotu" class="form-label fw-bold">Teklif Notu</label>
                            <textarea asp-for="TeklifNotu" class="form-control" rows="3" maxlength="500"></textarea>
                            <div class="text-end small text-muted"><span id="charCount">0</span>/500</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* 🎯 BUTONLAR *@
        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-3 mb-5">
            <a asp-action="Index" asp-controller="Project" class="btn btn-secondary btn-lg px-4">
                <i class="fas fa-times"></i> İptal
            </a>
            <button type="submit" class="btn btn-success btn-lg px-5" id="submitBtn">
                <i class="fas fa-save"></i> Teklifi Oluştur
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // 📝 Karakter Sayacı
        const noteArea = document.getElementById('TeklifNotu');
        const charCount = document.getElementById('charCount');
        if(noteArea && charCount) {
            charCount.textContent = noteArea.value.length;
            noteArea.addEventListener('input', function() {
                charCount.textContent = this.value.length;
                if(this.value.length >= 500) charCount.classList.add('text-danger');
                else charCount.classList.remove('text-danger');
            });
        }

        // 🚀 Çift Tıklama Önleme
        document.getElementById('teklifForm').addEventListener('submit', function() {
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Kaydediliyor...';
        });
    </script>
}