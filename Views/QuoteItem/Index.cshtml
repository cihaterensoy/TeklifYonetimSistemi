@model TeklifYonetimSistemi.Models.QuoteModel
@using System.Globalization
@{
    ViewData["Title"] = "Teklif Detayları";
    bool isTaslak = Model.Durum == TeklifYonetimSistemi.Models.QuoteStatus.Taslak;
    bool isRevize = Model.Durum == TeklifYonetimSistemi.Models.QuoteStatus.RevizeGerekiyor;
}

<div class="container-fluid mt-4">

    @* --- 1. ÜST BİLGİ KARTI (Sadeleştirildi) --- *@
    <div class="card mb-4 border shadow-sm">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="card-title text-dark fw-bold mb-1">
                        <i class="fas fa-file-alt me-2 text-secondary"></i>Teklif No: #@Model.TeklifNo
                    </h4>
                    <div class="text-muted small">
                        <span class="fw-semibold">@(Model.Project?.Customer?.FirmaUnvani ?? "Firma Belirtilmemiş")</span>
                        <span class="mx-2 text-secondary">|</span>
                        <span>@(Model.Project?.ProjeAdi ?? "Proje Belirtilmemiş")</span>
                    </div>
                </div>

                <div class="text-end">
                    <div class="mb-2">
                        <span class="badge bg-light text-secondary border fw-normal me-1">
                            USD: @Model.DolarKuru.ToString("N2") ₺
                        </span>
                        <span class="badge bg-light text-secondary border fw-normal">
                            EUR: @Model.EuroKuru.ToString("N2") ₺
                        </span>
                    </div>
                    <a asp-controller="Quote" asp-action="Index" class="btn btn-light btn-sm border text-muted">
                        <i class="fas fa-arrow-left me-1"></i> Geri Dön
                    </a>
                </div>
            </div>
        </div>
    </div>

    @* --- MESAJLAR --- *@
    @if (TempData["BasariMesaji"] != null)
    {
        <div class="alert alert-success py-2 mb-3 shadow-sm border-0 border-start border-4 border-success">
            <i class="fas fa-check me-2"></i> @TempData["BasariMesaji"]
        </div>
    }
    @if (TempData["HataMesaji"] != null)
    {
        <div class="alert alert-danger py-2 mb-3 shadow-sm border-0 border-start border-4 border-danger">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["HataMesaji"]
        </div>
    }

    @* --- 2. HESAPLAMA FORMU (Senin Düzenin, Ama Daha Zarif) --- *@
    @if (isTaslak || isRevize)
    {
        <div class="card border shadow-sm mb-4">
            @* Mavi arka planlı başlık yerine sade gri başlık *@
            <div class="card-header bg-white py-2 border-bottom">
                <h6 class="mb-0 fw-bold text-secondary"><i class="fas fa-plus-circle me-2"></i>Kalem Ekle</h6>
            </div>
            <div class="card-body bg-light bg-opacity-10">
                <form asp-action="AddItem" method="post" id="addItemForm">
                    <input type="hidden" name="quoteId" value="@Model.Id" />
                    <div class="row g-3 align-items-end">

                        @* ÜRÜN SEÇİMİ *@
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label small text-muted fw-bold mb-1">Ürün / Hizmet</label>
                            <select id="urunSecimi" name="productId" class="form-select" required>
                                <option value="" data-alis="0" data-marj="0" data-kdv="0">Seçiniz...</option>
                                @if (ViewBag.UrunListesi is List<TeklifYonetimSistemi.Models.ProductModel> urunler)
                                {
                                    foreach (var urun in urunler)
                                    {
                                        string jsAlis = urun.AlisFiyati.ToString("0.##", CultureInfo.InvariantCulture);
                                        string jsMarj = urun.VarsayilanKarMarji.ToString("0.##", CultureInfo.InvariantCulture);
                                        string jsKdv = urun.KDVOrani.ToString("0.##", CultureInfo.InvariantCulture);
                                        <option value="@urun.Id" data-alis="@jsAlis" data-marj="@jsMarj" data-kdv="@jsKdv" data-parabirimi="@(urun.ParaBirimi ?? "TL")">
                                            @urun.UrunAdi
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        @* MİKTAR *@
                        <div class="col-lg-1 col-md-2 col-6">
                            <label class="form-label small text-muted fw-bold mb-1">Miktar</label>
                            <input type="number" name="quantity" class="form-control text-center" value="1" min="1" required />
                        </div>

                        @* KUR (Gri tonlar) *@
                        <div class="col-lg-2 col-md-3 col-6">
                            <label class="form-label small text-muted fw-bold mb-1">Kur</label>
                            <div class="input-group">
                                <input type="number" id="inputKur" name="dovizKuru" class="form-control text-end" value="1" step="0.0001">
                                <span class="input-group-text bg-white text-muted small" id="lblKurTuru">TL</span>
                            </div>
                        </div>

                        @* MALİYET (Kırmızı yerine koyu gri/siyah daha profesyonel durur) *@
                        <div class="col-lg-2 col-md-4 col-6">
                            <label class="form-label small text-muted fw-bold mb-1">Birim Maliyet</label>
                            <div class="input-group">
                                <input type="number" id="inputMaliyet" name="alisMaliyeti" class="form-control" step="0.01" placeholder="0.00">
                                <span class="input-group-text bg-white text-muted small" id="lblMaliyetParaBirimi">TL</span>
                            </div>
                        </div>

                        @* KDV *@
                        <div class="col-lg-1 col-md-2 col-6">
                            <label class="form-label small text-muted fw-bold mb-1">KDV %</label>
                            <input type="number" id="inputKdv" name="kdvOrani" class="form-control text-center" min="0" max="100" value="0">
                        </div>

                        @* İSKONTOLAR (Input group sm ile küçültüldü) *@
                        <div class="col-lg-2 col-md-4">
                            <label class="form-label small text-muted fw-bold mb-1">İskontolar</label>
                            <div class="input-group input-group-sm">
                                <input type="number" name="isk1" class="form-control px-1 text-center" placeholder="1" step="0.01">
                                <input type="number" name="isk2" class="form-control px-1 text-center" placeholder="2" step="0.01">
                                <input type="number" name="isk3" class="form-control px-1 text-center" placeholder="3" step="0.01">
                            </div>
                        </div>

                        @* KÂR MARJI (Aşırı yeşil yerine sade input) *@
                        <div class="col-lg-1 col-md-3">
                            <label class="form-label small text-muted fw-bold mb-1">Kâr %</label>
                            <input type="number" id="inputMarj" name="karMarji" class="form-control text-success fw-bold" step="0.01" value="0">
                        </div>

                        <div class="col-lg-1 col-md-12 text-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-plus"></i> Ekle
                            </button>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    }

    @* --- 3. TABLO (Orijinal yapı, sade stil) --- *@
    <div class="card border shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                @* Table-dark yerine table-light kullanıldı (Fotoğraftaki gibi) *@
                <thead class="table-light text-secondary">
                    <tr class="text-uppercase small fw-bold">
                        <th style="width: 25%;">Ürün / Hizmet</th>
                        <th style="width: 8%;" class="text-center">Miktar</th>
                        <th style="width: 10%;" class="text-end">Net Maliyet</th>
                        <th style="width: 8%;" class="text-center">Kâr %</th>
                        <th style="width: 12%;" class="text-end">Birim Fiyat</th>
                        <th style="width: 10%;" class="text-center">KDV</th>
                        <th style="width: 15%;" class="text-end">Tutar</th>
                        @if (isTaslak ||isRevize)
                        {
                            <th style="width: 5%;"></th>
}
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model.QuoteItems != null && Model.QuoteItems.Any())
                    {
                        int rowIndex = 0;
                        foreach (var item in Model.QuoteItems)
                        {
                            rowIndex++;
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@item.UrunAdi</div>
                                    @if (!string.IsNullOrEmpty(item.Product?.Kategori))
                                    {
                                        <small class="text-muted">@item.Product.Kategori</small>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@item.Miktar.ToString("N2")</span>
                                </td>
                                <td class="text-end text-muted">
                                    @item.BirimMaliyet.ToString("N2") ₺
                                </td>
                                <td class="text-center text-success small">
                                    %@item.KarMarji.ToString("N2")
                                </td>
                                <td class="text-end fw-bold">
                                    @item.BirimSatisFiyati.ToString("N2") ₺
                                </td>
                                <td class="text-center">
                                    @if (isTaslak || isRevize)
                                    {
                                        <form asp-action="UpdateKDV" method="post" class="d-inline-block">
                                            <input type="hidden" name="itemId" value="@item.Id" />
                                            <input type="number" name="yeniKdvOrani"
                                                   value="@item.KDVOrani.ToString("0.##", CultureInfo.InvariantCulture)"
                                                   class="form-control form-control-sm text-center d-inline-block p-0 border-0 bg-transparent fw-bold"
                                                   style="width: 35px;" onchange="this.form.submit()" />
                                            <span class="small">%</span>
                                        </form>
                                    }
                                    else
                                    {
                                        <span>%@item.KDVOrani.ToString("0.##")</span>
                                    }
                                </td>
                                <td class="text-end fw-bold text-dark">
                                    @item.SatirGenelToplam.ToString("C2", new CultureInfo("tr-TR"))
                                </td>
                                @if (isTaslak || isRevize)
                                {
                                    <td class="text-center align-middle">
                                        <form asp-action="RemoveItem" method="post" onsubmit="return confirm('Silinsin mi?');">
                                            <input type="hidden" name="itemId" value="@item.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="fas fa-times me-1"></i> Sil
                                            </button>
                                        </form>
                                    </td>
                                }


                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                Henüz kalem eklenmemiş.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Alt Toplamlar (Gri arka plan, sağa yaslı) *@
        <div class="card-footer bg-light p-3">
            <div class="row justify-content-end text-end">
                <div class="col-md-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">Ara Toplam:</span>
                        <span class="fw-bold">@Model.AraToplam.ToString("C2", new CultureInfo("tr-TR"))</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">KDV:</span>
                        <span class="fw-bold">@Model.ToplamKDV.ToString("C2", new CultureInfo("tr-TR"))</span>
                    </div>
                    <div class="d-flex justify-content-between border-top pt-2">
                        <span class="text-dark fw-bold">GENEL TOPLAM:</span>
                        <span class="text-primary fw-bold fs-5">@Model.GenelToplam.ToString("C2", new CultureInfo("tr-TR"))</span>
                    </div>
                </div>
            </div>
        </div>
    </div>


    @* --- BUTONLAR --- *@
    <div class="d-flex justify-content-end gap-2 pb-5">
        @if (isTaslak || isRevize)
        {
            <a asp-controller="Quote" asp-action="Index" class="btn btn-light border text-muted">
                Kapat
            </a>
            <form asp-controller="Quote" asp-action="SubmitForApproval" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Onaya göndermek istiyor musunuz?');">
                <button type="submit" class="btn btn-success px-4 shadow-sm">
                    <i class="fas fa-check me-2"></i>Teklifi Onaya Gönder
                </button>
            </form>
        }

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Senin orijinal Javascript kodların aynen korundu
            const guncelDolar = @Model.DolarKuru.ToString("0.####", CultureInfo.InvariantCulture);
            const guncelEuro = @Model.EuroKuru.ToString("0.####", CultureInfo.InvariantCulture);

            const selectElement = document.getElementById('urunSecimi');
            const inputMaliyet = document.getElementById('inputMaliyet');
            const inputMarj = document.getElementById('inputMarj');
            const inputKdv = document.getElementById('inputKdv');
            const inputKur = document.getElementById('inputKur');
            const lblKurTuru = document.getElementById('lblKurTuru');
            const lblMaliyetParaBirimi = document.getElementById('lblMaliyetParaBirimi');

            if (selectElement) {
                selectElement.addEventListener('change', function () {
                    const selectedOption = this.options[this.selectedIndex];
                    const alis = selectedOption.getAttribute('data-alis');
                    const marj = selectedOption.getAttribute('data-marj');
                    const kdv = selectedOption.getAttribute('data-kdv');
                    const paraBirimi = selectedOption.getAttribute('data-parabirimi');

                    inputMaliyet.value = (alis && alis !== '0') ? alis : '';
                    inputMarj.value = (marj && marj !== '0') ? marj : '0';
                    inputKdv.value = (kdv && kdv !== '0') ? kdv : '0';

                    if (paraBirimi) {
                        lblMaliyetParaBirimi.innerText = paraBirimi;
                        if (paraBirimi === 'USD') {
                            inputKur.value = guncelDolar;
                            lblKurTuru.innerText = 'TL/USD';
                        }
                        else if (paraBirimi === 'EUR') {
                            inputKur.value = guncelEuro;
                            lblKurTuru.innerText = 'TL/EUR';
                        }
                        else {
                            inputKur.value = "1";
                            lblKurTuru.innerText = 'TL';
                        }
                    } else {
                        lblMaliyetParaBirimi.innerText = 'TL';
                        inputKur.value = "1";
                        lblKurTuru.innerText = 'TL';
                    }
                });
            }
        });
    </script>
}