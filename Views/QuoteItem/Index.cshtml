@model TeklifYonetimSistemi.Models.QuoteModel
@using System.Globalization
@{
    ViewData["Title"] = "Teklif Detayları ve Hesaplama";
    bool isTaslak = Model.Durum == TeklifYonetimSistemi.Models.QuoteStatus.Taslak;
}

<div class="container-fluid mt-4">
    @* --- 1. ÜST BİLGİ KARTI --- *@
    <div class="card mb-4 border-0 shadow-sm bg-white border-start border-5 border-primary">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h3 class="card-title text-primary fw-bold mb-1">
                        <i class="fas fa-file-invoice-dollar me-2"></i>Teklif No: #@Model.TeklifNo
                    </h3>
                    <div class="text-muted mb-2">
                        <i class="fas fa-building me-1"></i> @(Model.Project?.Customer?.FirmaUnvani ?? "Firma Belirtilmemiş")
                        <span class="mx-2">|</span>
                        <i class="fas fa-project-diagram me-1"></i> @(Model.Project?.ProjeAdi ?? "Proje Belirtilmemiş")
                    </div>
                </div>
                <div class="text-end mt-3 mt-md-0">
                    <div class="d-flex gap-2 mb-2 justify-content-end flex-wrap">
                        <span class="badge bg-light text-dark border p-2">
                            <i class="fas fa-dollar-sign me-1"></i>USD: @Model.DolarKuru.ToString("N2") ₺
                        </span>
                        <span class="badge bg-light text-dark border p-2">
                            <i class="fas fa-euro-sign me-1"></i>EUR: @Model.EuroKuru.ToString("N2") ₺
                        </span>
                    </div>
                    <a asp-controller="Quote" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-arrow-left me-1"></i> Listeye Dön
                    </a>
                </div>
            </div>
        </div>
    </div>

    @* --- MESAJLAR --- *@
    @if (TempData["BasariMesaji"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <strong>Başarılı!</strong> @TempData["BasariMesaji"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }
    @if (TempData["HataMesaji"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Hata!</strong> @TempData["HataMesaji"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    @* --- 2. HESAPLAMA FORMU (YENİ ÜRÜN EKLEME) --- *@
    @if (isTaslak)
    {
        <div class="card shadow mb-4">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0"><i class="fas fa-cart-plus me-2"></i>Yeni Kalem Ekle</h5>
            </div>
            <div class="card-body bg-light">
                <form asp-action="AddItem" method="post" id="addItemForm">
                    <input type="hidden" name="quoteId" value="@Model.Id" />
                    <div class="row g-3 align-items-end">
                        @* ÜRÜN SEÇİMİ *@
                        <div class="col-lg-4 col-md-6">
                            <label for="urunSecimi" class="form-label fw-bold text-dark">
                                <i class="fas fa-box me-1"></i>Ürün / Hizmet Seçimi
                            </label>
                            <select id="urunSecimi" name="productId" class="form-select form-select-lg border-primary" required>
                                <option value="" data-alis="0" data-marj="0" data-kdv="0">-- Listeden Seçiniz --</option>
                                @if (ViewBag.UrunListesi is List<TeklifYonetimSistemi.Models.ProductModel> urunler)
                                {
                                    @foreach (var urun in urunler)
                                    {
                                        string jsAlis = urun.AlisFiyati.ToString("0.##", CultureInfo.InvariantCulture);
                                        string jsMarj = urun.VarsayilanKarMarji.ToString("0.##", CultureInfo.InvariantCulture);
                                        string jsKdv = urun.KDVOrani.ToString("0.##", CultureInfo.InvariantCulture);
                                        string gorunenMetin = $"{urun.UrunAdi} ({urun.SatisFiyatListesi:N2} {urun.ParaBirimi})"; // Para birimini buraya da ekledim

                                        <option value="@urun.Id"
                                                data-alis="@jsAlis"
                                                data-marj="@jsMarj"
                                                data-kdv="@jsKdv"
                                                data-parabirimi="@(urun.ParaBirimi ?? "TL")">
                                            @* YENİ EKLENEN KISIM *@
                                            @gorunenMetin
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        @* MİKTAR *@
                        <div class="col-lg-1 col-md-2 col-6">
                            <label for="inputMiktar" class="form-label fw-bold">Miktar</label>
                            <input type="number" id="inputMiktar" name="quantity"
                                   class="form-control form-control-lg text-center fw-bold"
                                   value="1" min="1" step="1" required />
                        </div>

                        @* YENİ: KUR GİRİŞ ALANI *@
                        <div class="col-lg-2 col-md-3 col-6">
                            <label for="inputKur" class="form-label fw-bold text-muted">İşlem Kuru</label>
                            <div class="input-group">
                                <input type="number" id="inputKur" name="dovizKuru"
                                       class="form-control text-center fw-bold border-info"
                                       value="1" step="0.0001" min="0" required>
                                <span class="input-group-text" id="lblKurTuru">TL</span>
                            </div>
                        </div>

                        @* GÜNCELLENEN: MALİYET ALANI *@
                        <div class="col-lg-2 col-md-4 col-6">
                            <label for="inputMaliyet" class="form-label fw-bold text-danger">
                                <i class="fas fa-money-bill-wave me-1"></i>Birim Maliyet
                            </label>
                            <div class="input-group">
                                <input type="number" id="inputMaliyet" name="alisMaliyeti"
                                       class="form-control text-danger fw-bold"
                                       step="0.01" min="0" placeholder="0.00" required>
                                @* Buradaki simge artık JS ile değişecek *@
                                <span class="input-group-text" id="lblMaliyetParaBirimi">TL</span>
                            </div>
                        </div>

                        @* KDV ALANI *@
                        <div class="col-lg-1 col-md-2 col-6">
                            <label for="inputKdv" class="form-label fw-bold text-muted">KDV %</label>
                            <div class="input-group">
                                <input type="number" id="inputKdv" name="kdvOrani"
                                       class="form-control text-center fw-bold"
                                       min="0" max="100" step="1" value="0" required>
                                <span class="input-group-text">%</span>
                            </div>
                        </div>

                        @* İSKONTOLAR *@
                        <div class="col-lg-2 col-md-4">
                            <label class="form-label fw-bold small text-muted">
                                <i class="fas fa-percent me-1"></i>İskontolar (%)
                            </label>
                            <div class="input-group input-group-sm">
                                <input type="number" name="isk1" class="form-control px-1"
                                       placeholder="İsk1" value="0" min="0" max="100" step="0.01">
                                <input type="number" name="isk2" class="form-control px-1"
                                       placeholder="İsk2" value="0" min="0" max="100" step="0.01">
                                <input type="number" name="isk3" class="form-control px-1"
                                       placeholder="İsk3" value="0" min="0" max="100" step="0.01">
                            </div>
                        </div>

                        @* KÂR MARJI *@
                        <div class="col-lg-1 col-md-3">
                            <label for="inputMarj" class="form-label fw-bold text-success">
                                <i class="fas fa-chart-line me-1"></i>Kâr %
                            </label>
                            <input type="number" id="inputMarj" name="karMarji"
                                   class="form-control text-success fw-bold border-success"
                                   step="0.01" min="0" value="0" required>
                        </div>

                        @* BUTON *@
                        <div class="col-lg-1 col-md-12">
                            <button type="submit" class="btn btn-primary w-100 btn-lg shadow-sm">
                                <i class="fas fa-plus me-1"></i> Ekle
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }

    @* --- 3. TABLO (MEVCUT KALEMLER) --- *@
    <div class="card shadow-sm mb-5">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 text-dark">
                <i class="fas fa-list-ol me-2"></i>Teklif Kalemleri
                @if (Model.QuoteItems != null && Model.QuoteItems.Any())
                {
                    <span class="badge bg-primary ms-2">@Model.QuoteItems.Count</span>
                }
            </h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle mb-0" style="font-size: 0.95rem;">
                <thead class="table-dark text-center">
                    <tr>
                        <th style="width: 25%;" class="text-start">Ürün / Hizmet</th>
                        <th style="width: 8%;">Miktar</th>
                        <th style="width: 10%;" class="bg-secondary bg-opacity-25 text-dark border-secondary">Net Maliyet</th>
                        <th style="width: 8%;">Kâr %</th>
                        <th style="width: 12%;">Birim Satış</th>
                        <th style="width: 10%;">KDV</th>
                        <th style="width: 15%;">Satır Toplamı<br><small>(KDV Dahil)</small></th>
                        @if (isTaslak)
                        {
                            <th style="width: 5%;">İşlem</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model.QuoteItems != null && Model.QuoteItems.Any())
                    {
                        int rowIndex = 0;
                        foreach (var item in Model.QuoteItems)
                        {
                            rowIndex++;
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">
                                        <span class="badge bg-light text-dark me-2">@rowIndex</span>
                                        @item.UrunAdi
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.Product?.Kategori))
                                    {
                                        <div class="small text-muted mt-1">
                                            <i class="fas fa-tag me-1"></i>@item.Product.Kategori
                                        </div>
                                    }
                                </td>
                                <td class="text-center fw-bold bg-light">
                                    @item.Miktar.ToString("N2") <span class="small text-muted">@(item.Birim ?? "adet")</span>
                                </td>
                                <td class="text-end text-danger bg-light border-end">
                                    @item.BirimMaliyet.ToString("N2") ₺
                                </td>
                                <td class="text-center text-success fw-bold">
                                    %@item.KarMarji.ToString("N2")
                                </td>
                                <td class="text-end fw-bold text-primary">
                                    @item.BirimSatisFiyati.ToString("N2") ₺
                                </td>
                                <td class="text-center p-2">
                                    @if (isTaslak)
                                    {
                                        <form asp-action="UpdateKDV" method="post" class="d-flex flex-column align-items-center justify-content-center">
                                            <input type="hidden" name="itemId" value="@item.Id" />
                                            <div class="input-group input-group-sm" style="max-width: 100px;">
                                                <input type="number" name="yeniKdvOrani"
                                                       value="@item.KDVOrani.ToString("0.##", CultureInfo.InvariantCulture)"
                                                       class="form-control text-center px-1 fw-bold border-secondary"
                                                       min="0" max="100" step="1"
                                                       onchange="this.form.submit()"
                                                       title="KDV Oranı" />
                                                <span class="input-group-text px-1">%</span>
                                            </div>
                                            <small class="text-muted mt-1" style="font-size:0.75rem;">
                                                (@item.KDVTutari.ToString("N2") ₺)
                                            </small>
                                        </form>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column align-items-center">
                                            <span class="badge bg-light text-dark border">
                                                %@item.KDVOrani.ToString("0.##")
                                            </span>
                                            <small class="text-muted mt-1">@item.KDVTutari.ToString("N2") ₺</small>
                                        </div>
                                    }
                                </td>
                                <td class="text-end fw-bold bg-light fs-6">
                                    @item.SatirGenelToplam.ToString("C2", new CultureInfo("tr-TR"))
                                </td>
                                @if (isTaslak)
                                {
                                    <td class="text-center">
                                        <form asp-action="RemoveItem" method="post"
                                              onsubmit="return confirm('Bu kalemi silmek istediğinize emin misiniz?');">
                                            <input type="hidden" name="itemId" value="@item.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm border-0"
                                                    title="Sil">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="fas fa-calculator fa-3x mb-3 text-secondary opacity-50"></i>
                                    <h5>Henüz ürün eklenmemiş.</h5>
                                    @if (isTaslak)
                                    {
                                        <p class="small">Yukarıdaki formu kullanarak yeni kalem ekleyebilirsiniz.</p>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* --- TOPLAMLAR --- *@
        <div class="card-footer bg-white p-0">
            <div class="row m-0">
                <div class="col-md-8 d-none d-md-block bg-light border-end"></div>
                <div class="col-md-4 p-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Ara Toplam:</span>
                        <span class="fw-bold text-dark">@Model.AraToplam.ToString("C2", new CultureInfo("tr-TR"))</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Toplam KDV:</span>
                        <span class="fw-bold text-dark">@Model.ToplamKDV.ToString("C2", new CultureInfo("tr-TR"))</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fs-5 fw-bold text-primary">GENEL TOPLAM:</span>
                        <span class="fs-4 fw-bold text-success">@Model.GenelToplam.ToString("C2", new CultureInfo("tr-TR"))</span>
                    </div>
                </div>
            </div>
        </div>
    </div>


    @* --- BUTONLAR --- *@
    @if (isTaslak)
    {
        <div class="mt-4 text-end">
            <form>
                <button a class="nav-link" asp-controller="Quote" asp-action="Index" type="submit" class="btn btn-lg btn-warning text-dark shadow">
                    <i class="fas fa-paper-plane"></i> Taslak Olarak Kaydet ve Kapat
                </button>
            </form>
        </div>
    }
    <div class="d-flex justify-content-end gap-3 pb-5">

        @if (isTaslak)
        {
            <form asp-controller="Quote" asp-action="SubmitForApproval" asp-route-id="@Model.Id"
                  method="post" onsubmit="return confirm('Teklifi onaya göndermek istediğinize emin misiniz?');">
                <button type="submit" class="btn btn-success btn-lg shadow">
                    <i class="fas fa-paper-plane me-2"></i>Teklifi Onaya Gönder
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Backend'den gelen kurları JS değişkenlerine alıyoruz
            // CultureInfo.InvariantCulture önemli, yoksa 34,50 gelir ve JS hata verir.
            const guncelDolar = @Model.DolarKuru.ToString("0.####", CultureInfo.InvariantCulture);
            const guncelEuro = @Model.EuroKuru.ToString("0.####", CultureInfo.InvariantCulture);

            const selectElement = document.getElementById('urunSecimi');
            const inputMaliyet = document.getElementById('inputMaliyet');
            const inputMarj = document.getElementById('inputMarj');
            const inputKdv = document.getElementById('inputKdv');

            // Yeni Eklenen Elementler
            const inputKur = document.getElementById('inputKur');
            const lblKurTuru = document.getElementById('lblKurTuru');
            const lblMaliyetParaBirimi = document.getElementById('lblMaliyetParaBirimi');

            if (selectElement) {
                selectElement.addEventListener('change', function () {
                    const selectedOption = this.options[this.selectedIndex];

                    // Verileri al
                    const alis = selectedOption.getAttribute('data-alis');
                    const marj = selectedOption.getAttribute('data-marj');
                    const kdv = selectedOption.getAttribute('data-kdv');
                    const paraBirimi = selectedOption.getAttribute('data-parabirimi');

                    // 1. Maliyet, Marj, KDV Doldurma
                    inputMaliyet.value = (alis && alis !== '0') ? alis : '';
                    inputMarj.value = (marj && marj !== '0') ? marj : '0';
                    inputKdv.value = (kdv && kdv !== '0') ? kdv : '0';

                    // 2. Para Birimi ve Kur Mantığı
                    if (paraBirimi) {
                        lblMaliyetParaBirimi.innerText = paraBirimi; // Maliyet yanındaki simge (USD, EUR, TL)

                        if (paraBirimi === 'USD') {
                            inputKur.value = guncelDolar;
                            lblKurTuru.innerText = 'TL/USD'; // 1 USD kaç TL
                        }
                        else if (paraBirimi === 'EUR') {
                            inputKur.value = guncelEuro;
                            lblKurTuru.innerText = 'TL/EUR';
                        }
                        else {
                            // TL veya diğerleri
                            inputKur.value = "1";
                            lblKurTuru.innerText = 'TL';
                        }
                    } else {
                        // Seçim iptal edilirse varsayılana dön
                        lblMaliyetParaBirimi.innerText = 'TL';
                        inputKur.value = "1";
                        lblKurTuru.innerText = 'TL';
                    }
                });
            }

            // Form Submit Validasyonu 
            const form = document.getElementById('addItemForm');
            if (form) {
                form.addEventListener('submit', function (e) {
                    if (!selectElement.value) {
                        e.preventDefault();
                        alert('Lütfen bir ürün seçiniz!');
                        selectElement.focus();
                    }
                });
            }
        });
    </script>
}
