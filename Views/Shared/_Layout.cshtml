@using Microsoft.AspNetCore.Identity
@using TeklifYonetimSistemi.Models
@inject UserManager<KullaniciModel> UserManager
@inject SignInManager<KullaniciModel> SignInManager
@{
    // Kullanıcının bilgilerini çekiyoruz
    var currentUser = await UserManager.GetUserAsync(User);

    // Eğer giriş yapılmamışsa veya isim girilmemişse varsayılan bir şey yazsın
    string adSoyad = "Misafir Kullanıcı";
    string yetki = "";
    if (currentUser != null)
    {
        adSoyad = $"{currentUser.Isim} {currentUser.Soyisim}";
        var roller = await UserManager.GetRolesAsync(currentUser);
        // İlk bulunan rolü (yetkiyi) alır, yoksa "Standart Üye" yazar.
        yetki = $"{roller.FirstOrDefault() ?? "Standart Üye"}";
    }
}
<!doctype html>
<html lang="en" class="light-theme">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="~/assets/images/favicon-32x32.png" type="image/png" />

    <link href="~/assets/plugins/simplebar/css/simplebar.css" rel="stylesheet" />
    <link href="~/assets/plugins/perfect-scrollbar/css/perfect-scrollbar.css" rel="stylesheet" />
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/css/bootstrap-extended.css" rel="stylesheet" />
    <link href="~/assets/css/style.css" rel="stylesheet" />
    <link href="~/assets/css/icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
    <link href="~/assets/css/pace.min.css" rel="stylesheet" />
    <link href="~/assets/css/dark-theme.css" rel="stylesheet" />
    <link href="~/assets/css/light-theme.css" rel="stylesheet" />
    <link href="~/assets/css/semi-dark.css" rel="stylesheet" />
    <link href="~/assets/css/header-colors.css" rel="stylesheet" />

</head>

<body>

    <div class="wrapper">

        <header class="top-header">
            <nav class="navbar navbar-expand">

                <div class="mobile-toggle-icon d-xl-none">
                    <i class="bi bi-list"></i>
                </div>

                <div class="top-navbar d-none d-xl-block">
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Project" asp-action="Index">Projeler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Quote" asp-action="Index">Teklif Listesi</a>
                        </li>
                        <li class="nav-item d-none d-xxl-block">
                            <a class="nav-link" asp-controller="Product" asp-action="Liste">Ürünler & Hizmetler</a>
                        </li>
                    </ul>
                </div>

                <form class="searchbar d-none d-xl-flex ms-auto">
                    <div class="position-absolute top-50 translate-middle-y search-icon ms-3"><i class="bi bi-search"></i></div>
                    <input class="form-control" type="text" placeholder="Ara...">
                    <div class="position-absolute top-50 translate-middle-y d-block d-xl-none search-close-icon"><i class="bi bi-x-lg"></i></div>
                </form>

                <div class="top-navbar-right ms-3">
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item dropdown dropdown-large">
                            <a class="nav-link dropdown-toggle dropdown-toggle-nocaret" href="#" data-bs-toggle="dropdown">
                                <div class="user-setting d-flex align-items-center gap-1">
                                    <img src="~/assets/images/avatars/avatar-1.png" class="user-img" alt="">
                                    <div class="user-name d-none d-sm-block">@adSoyad</div>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" href="#">
                                        <div class="d-flex align-items-center">
                                            <img src="~/assets/images/avatars/avatar-1.png" alt="" class="rounded-circle" width="60" height="60">
                                            <div class="ms-3">
                                                <h6 class="mb-0 dropdown-user-name">@adSoyad</h6>
                                                <small class="mb-0 dropdown-user-designation text-secondary">@yetki</small>
                                            </div>
                                        </div>
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="#">
                                        <div class="d-flex align-items-center">
                                            <div class="setting-icon"><i class="bi bi-person-fill"></i></div>
                                            <div class="setting-text ms-3"><span>Profil</span></div>
                                        </div>
                                    </a>
                                </li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li class="dropdown-item p-0">
                                        <form asp-controller="KullaniciEkle" asp-action="Ekle" method="post" style="display:block; margin:0; padding:0;">
                                            <button type="submit" class="dropdown-item d-flex align-items-center" style="border:none; background:none; width:100%; cursor:pointer;">
                                                <div class="setting-icon"><i class="bi bi-person-plus-fill"></i></div>
                                                <div class="setting-text ms-3">
                                                    <span>Kullanici Ekle</span>
                                                </div>
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="KullaniciEkle" asp-action="Index">
                                            <div class="d-flex align-items-center">
                                                <div class="setting-icon">
                                                    <i class="bi bi-people-fill"></i>
                                                </div>
                                                <div class="setting-text ms-3">
                                                    <span>Kullanıcı Listesi</span>
                                                </div>
                                            </div>
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                <li class="dropdown-item p-0">
                                    <form asp-controller="Login" asp-action="Logout" method="post" style="display:block; margin:0; padding:0;">
                                        <button type="submit" class="dropdown-item d-flex align-items-center" style="border:none; background:none; width:100%; cursor:pointer;">
                                            <div class="setting-icon"><i class="bi bi-box-arrow-right"></i></div>
                                            <div class="setting-text ms-3">
                                                <span>Çıkış Yap</span>
                                            </div>
                                        </button>
                                    </form>
                                </li>
                        </li>
                    </ul>
                    </li>
                    </ul>
                </div>
            </nav>
        </header>

        <aside class="sidebar-wrapper">
            <div class="iconmenu">
                <div class="nav-toggle-box">
                    <div class="nav-toggle-icon"><i class="bi bi-list"></i></div>
                </div>
                <ul class="nav nav-pills flex-column">
                    <li class="nav-item" data-bs-toggle="tooltip" data-bs-placement="right" title="Yönetim">
                        <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#pills-dashboards" type="button"><i class="bi bi-house-door-fill"></i></button>
                    </li>
                </ul>
            </div>

            <div class="textmenu">
                <div>

                </div>
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="pills-dashboards">
                        <div class="list-group list-group-flush">
                            <div class="list-group-item">
                                <div class="d-flex w-100 justify-content-between">
                                    <h5 class="mb-0">Menüler</h5>
                                </div>
                            </div>
                            <a asp-controller="Home" asp-action="Index" class="list-group-item"><i class="bi bi-house-door-fill"></i> Ana Sayfa</a>
                            @if (User.IsInRole("Admin") || User.IsInRole("SatisElemani"))
                            {
                                <a asp-controller="Musteri" asp-action="ana" class="list-group-item"><i class="bi bi-people"></i> Müşteriler</a>
                            }
                            <a asp-controller="Quote" asp-action="Index" class="list-group-item"><i class="bi bi-file-earmark-text"></i> Teklif Listesi</a>
                            <a asp-controller="Project" asp-action="Index" class="list-group-item"><i class="bi bi-kanban"></i> Projeler</a>
                            <a asp-controller="Product" asp-action="Liste" class="list-group-item"><i class="bi bi-box"></i> Ürünler & Hizmetler</a>
                            <a asp-controller="Order" asp-action="Index" class="list-group-item"><i class="bi bi-bag"></i> Siparişlerim</a>
                            <a href="#" class="list-group-item"><i class="bi bi-gear"></i> Ayarlar</a>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <main class="page-content">
            @RenderBody()
        </main>

        <div class="overlay nav-toggle-icon"></div>
        <a href="javaScript:;" class="back-to-top"><i class='bx bxs-up-arrow-alt'></i></a>
    </div>

    <script src="~/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/jquery.min.js"></script>
    <script src="~/assets/plugins/simplebar/js/simplebar.min.js"></script>
    <script src="~/assets/plugins/perfect-scrollbar/js/perfect-scrollbar.js"></script>
    <script src="~/assets/js/pace.min.js"></script>

    <script src="~/assets/js/app.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>$(document).ready(function () {

            if ($('.wrapper').hasClass('toggled')) {
                $('.wrapper').removeClass('toggled');
            }
        });</script>
    </body>
</html>